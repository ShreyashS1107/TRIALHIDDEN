{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./FRONTEND",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "typeRoots": [
      "./FRONTEND/node_modules/@types"
    ]
  },
  "include": [
    "FRONTEND/next-env.d.ts",
    "FRONTEND/**/*.ts",
    "FRONTEND/**/*.tsx"
  ],
  "exclude": [
    "TRIALHIDDEN",
    ".venv",
    ".git"
  ]
}
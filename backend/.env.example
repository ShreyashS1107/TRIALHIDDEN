# Database Configuration
# Supabase PostgreSQL connection string placeholder
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Server Settings
API_PORT=8000
API_HOST=0.0.0.0

# Redis Cache Settings
REDIS_URL=redis://localhost:6379/1

# Security & Secret Keys
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
